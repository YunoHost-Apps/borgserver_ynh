#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE FILES
#=================================================
ynh_script_progression "Restoring backuped files..."
ynh_restore_everything

#=================================================
# REVERT UPGRADE MODIFICATIONS
#=================================================
if ynh_app_upgrading_from_version_before_or_equal_to "1.4.0~ynh1"; then
    ynh_script_progression "Reverting upgrade modifications..."
    ynh_system_user_create --username="$ssh_user" --home_dir="/home/$ssh_user" --use_shell --groups ssh.app
    repository_to_delete="$ssh_user"
    ynh_hide_warnings delete_repository
    ynh_app_setting_delete --key="${repository_to_delete}_public_key"
    ynh_app_setting_delete --key="${repository_to_delete}_quota"
    ynh_app_setting_delete --key="${repository_to_delete}_alert_delay"
    ynh_app_setting_delete --key="${repository_to_delete}_alert_mails"
fi

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
